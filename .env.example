# Copiez ce fichier en .env et remplacez les placeholders. Ne commitez jamais .env.
# Valeurs PUBLIQUES uniquement (EXPO_PUBLIC_* est embarqué dans l'app).
# EXPO_PUBLIC_EXAMPLE_ENV_VAR est supprimée : ne pas la réintroduire.
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Journal de crash. Laissé en placeholder = Sentry désactivé, l'app démarre quand même.
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN

# Autres placeholders (non lus au démarrage, aucune valeur inventée) :
# YOUR_SCHOOL_HOLIDAYS_ICS_URL
# YOUR_SUPPORT_EMAIL
# YOUR_REVIEW_ACCOUNT
# FEATURE_CUSTODY=false
# FEATURE_EXPENSES=false
# FEATURE_MESSAGES=false
# FEATURE_SMS=false

# Phase 2 — serveur uniquement, JAMAIS en EXPO_PUBLIC_ :
# TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
# TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
# TWILIO_FROM_NUMBER=YOUR_TWILIO_FROM_NUMBER
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
